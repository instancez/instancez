DROP POLICY IF EXISTS storage_avatars_insert_1 ON storage.objects;

CREATE POLICY storage_avatars_insert_1 ON storage.objects AS PERMISSIVE FOR INSERT WITH CHECK (bucket_id = 'avatars' AND (auth.is_authenticated()));

DROP POLICY IF EXISTS storage_avatars_update_2 ON storage.objects;

CREATE POLICY storage_avatars_update_2 ON storage.objects AS PERMISSIVE FOR UPDATE USING (bucket_id = 'avatars' AND (auth.is_authenticated())) WITH CHECK (bucket_id = 'avatars' AND (auth.is_authenticated()));

DROP POLICY IF EXISTS storage_avatars_delete_3 ON storage.objects;

CREATE POLICY storage_avatars_delete_3 ON storage.objects AS PERMISSIVE FOR DELETE USING (bucket_id = 'avatars' AND (auth.is_authenticated()));

